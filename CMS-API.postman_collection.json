{
  "info": {
    "name": "CSE470 Lab - Content Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set the collection variable baseUrl to your server address (http://localhost:8000 or your public Codespaces URL). Run the requests top to bottom."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "contentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create",
      "item": [
        {
          "name": "Create content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Exam routine\",\n  \"body\": \"Midterm exams start on 20 November.\",\n  \"author\": \"Arif\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"contentId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create without title (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"no title\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Read",
      "item": [
        {
          "name": "Get all contents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get published only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents?status=published",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "published"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing id (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Update",
      "item": [
        {
          "name": "Publish content",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Now published\", () => pm.expect(pm.response.json().status).to.eql(\"published\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Delete",
      "item": [
        {
          "name": "Delete content",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete again (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}