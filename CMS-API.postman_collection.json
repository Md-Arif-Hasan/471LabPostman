{
  "info": {
    "name": "CSE470 Lab - Content Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD on a content management system. Set the collection variable baseUrl to http://localhost:8000 or your public Codespaces URL."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "contentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create",
      "item": [
        {
          "name": "Create content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Exam routine\",\n  \"body\": \"Midterm exams start on 20 November.\",\n  \"author\": \"Arif\",\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"contentId\", pm.response.json().id);",
                  "pm.test(\"Has an id\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create without title -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"no title\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create with bad status -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad\",\n  \"status\": \"live\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Read",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all contents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by status (query param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents?status=published",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "published"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All published\", () => pm.response.json().forEach(c => pm.expect(c.status).to.eql(\"published\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one by id (path param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Update",
      "item": [
        {
          "name": "Publish content",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Now published\", () => pm.expect(pm.response.json().status).to.eql(\"published\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit title and body",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Exam routine (updated)\",\n  \"body\": \"Midterm exams start on 22 November.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Delete",
      "item": [
        {
          "name": "Delete content",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete again -> 404",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/contents/{{contentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contents",
                "{{contentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}